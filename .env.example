# ──────────────────────────────────────────────
# yunwei 自动化项目 — 环境变量模板 (.env.example)
# 复制为 .env 并填入真实值 (不要提交 .env!)
# ──────────────────────────────────────────────

# ── Fusion MCP 连接 ──
FUSION_MCP_URL=http://127.0.0.1:27182
FUSION_MCP_TIMEOUT=60

# ── 项目路径 ──
# 生成的模型导出目录 (绝对路径)
MODEL_EXPORT_DIR=/Users/betty/Documents/trae_projects/yunwei/models

# 日志目录
LOG_DIR=/Users/betty/Documents/trae_projects/yunwei/logs

# ── Fusion 文档 (可选) ──
# 如果指定了 Fusion Team 中的文档 ID，脚本可以自动打开
# FUSION_DOC_ID=

# ── GitHub (仅在需要脚本自动推送时使用) ──
# 不要把真实 token 写进 .env.example！
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxx
# GITHUB_OWNER=Betty0601
# GITHUB_REPO=yunwei
